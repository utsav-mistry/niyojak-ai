# Go build outputs
*.exe
*.out
/bin/

# Go module cache (never commit)
vendor/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Python virtual environment
.venv/
venv/
env/

# Trained model file (generated by train_model.py, baked into Docker image)
ai_service/model/*.pkl

# SQLite database (runtime artifact, stored in K8s volume)
*.db
*.db-wal
*.db-shm

# Node.js
sample_app/node_modules/
sample_app/.npm/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test / coverage artifacts
coverage/
*.cover
*.prof

# Kubernetes secrets (never commit real credentials)
kubeconfig
*.kubeconfig
secrets.yaml

# Environment files
.env
.env.local
